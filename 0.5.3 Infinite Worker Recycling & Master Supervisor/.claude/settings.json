{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "language": "korean",
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./credentials/**)",
      "Read(**/*.dmp)",
      "Read(**/*.pdb)",
      "Read(**/*.obj)",
      "Read(**/*.exe)",
      "Read(fuzz_session_*/**)",
      "Read(**/*.log)",
      "Execute(**/Fuzzer*.exe)",
      "Execute(**/WinKernel*.exe)"
    ]
  }
}