# WinKernel Fuzzer - 로컬 설정 템플릿
# ---------------------------------------------------------------------------
# 사용법: 이 파일을 fuzzer.env 로 복사한 뒤 값을 채우세요.
#     copy fuzzer.env.example fuzzer.env
#
# - 이 예시 파일(fuzzer.env.example)은 git 에 커밋됩니다.
# - 실제 값이 담긴 fuzzer.env 는 .gitignore 로 추적 제외됩니다. 절대 커밋하지 마세요.
# - 우선순위: fuzzer.env > 프로세스 환경변수 > monitoring.py 내 기본값
# - 형식: KEY=VALUE ('#' 은 주석). 값에 공백/역슬래시가 있어도 그대로 적으면 됩니다(따옴표 선택).
# ---------------------------------------------------------------------------

# ===== 필수 =====
# VM 의 .vmx 파일 절대경로      예) C:\VMs\win11\Windows 11 x64.vmx
VMX_PATH=
# 게스트 로그인 비밀번호
VM_PASS=
# vmrun 접근 비밀번호
VM_ACCESS_PASS=
# 호스트의 워커 exe 절대경로     예) C:\VM_Shared_Folder\worker.exe
HOST_WORKER_EXE=
# 크래시/시드(pending_seed.bin, crashes/) 를 저장할 호스트 디렉터리   예) C:\VM_Shared_Folder
HOST_SHARED_DIR=

# ===== 선택 (미지정 시 괄호 안 기본값 사용) =====
# vmrun.exe 경로 (기본: C:\Program Files (x86)\VMware\VMware Workstation\vmrun.exe)
#VMRUN_PATH=C:\Program Files (x86)\VMware\VMware Workstation\vmrun.exe
# 되돌릴 스냅샷 이름 (기본: set_host)
#SNAPSHOT_NAME=set_host
# 게스트 로그인 계정 (기본: Administrator)
#VM_USER=Administrator
# 게스트 내 스테이징 디렉터리 (기본: C:\Fuzz)
#GUEST_LOCAL_DIR=C:\Fuzz
# 게스트 내 스테이징 exe 경로 (기본: GUEST_LOCAL_DIR + HOST_WORKER_EXE 의 파일명)
#GUEST_LOCAL_EXE=C:\Fuzz\worker.exe
# 게스트가 접속할 호스트 IP (기본: 비우면 사설 대역에서 자동 감지)
# P3 소스 필터의 허용 대역(host_ip /24) 산출에도 사용됩니다.
#HOST_IP_FOR_GUEST=192.168.175.1
